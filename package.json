{
  "name": "chat-to-qa-preview",
  "version": "0.0.0",
  "private": true,
  "description": "Local preview that turns one exported AI chat into one grounded, redacted Q&A. Synthetic evaluation only; not a privacy guarantee.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan-tracked": "node scripts/scan-tracked.ts",
    "admit-data": "node scripts/admit-data.ts",
    "eval": "node scripts/eval.ts",
    "freeze": "node scripts/freeze.ts",
    "demo": "node scripts/demo.ts",
    "sync-function-lib": "node scripts/sync-function-lib.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.26.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
